rules_version = '2';
// Mỗi người có một "sổ" riêng: books/{mã ngẫu nhiên 20-40 ký tự}. Ai có link (mã) thì đọc/sửa được sổ đó.
// Không cho liệt kê hay xoá sổ, nên không ai dò được sổ của người khác.
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{code} {
      allow get: if code.matches('^[A-Za-z0-9]{20,40}$');
      allow create, update: if code.matches('^[A-Za-z0-9]{20,40}$')
        && request.resource.data.keys().hasOnly(['data', 'updatedAt']);
      allow list, delete: if false;
    }
  }
}
